{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/check-secrets.sh\"; [ -x \"$f\" ] && bash -n \"$f\" 2>/dev/null || exit 0; \"$f\" --hook"
          }
        ]
      }
    ]
  }
}
